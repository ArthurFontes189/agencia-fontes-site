---
const { items } = Astro.props;

// Group FAQs by category
const categories = {
  gerais: 'Gerais',
  tecnico: 'Técnico',
  preco: 'Preço',
};

const faqsByCategory = Object.keys(categories).reduce(
  (acc, cat) => {
    acc[cat] = items.filter((item) => item.category === cat);
    return acc;
  },
  {} as Record<string, typeof items>
);
---

<section id="faq" class="faq-section">
  <div class="container">
    <h2 class="section-title">Perguntas frequentes</h2>
    <p class="section-subtitle">Tira suas dúvidas aqui</p>

    {/* FAQ Categories Tabs */}
    <div class="faq-tabs">
      {Object.keys(categories).map((category, index) => (
        <button
          class={`faq-tab-button ${category === 'gerais' ? 'active' : ''}`}
          data-category={category}
          title={categories[category as keyof typeof categories]}
        >
          <span class="tab-label">{String(index + 1).padStart(2, '0')}</span>
          <span class="tab-text" style="font-size: 0.7rem; opacity: 0.7;">{categories[category as keyof typeof categories]}</span>
        </button>
      ))}
    </div>

    {/* FAQ Content by Category */}
    <div class="faq-content">
      {Object.keys(categories).map((category) => (
        <div
          class={`faq-category ${category === 'gerais' ? 'active' : ''}`}
          data-category-content={category}
        >
          <div class="faq-list">
            {faqsByCategory[category].map((item, index) => (
              <div class="faq-item" data-faq={index}>
                <button class="faq-question">
                  <span>{item.question}</span>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="6 9 12 15 18 9" />
                  </svg>
                </button>
                <div class="faq-answer">
                  <p>{item.answer}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Category tab switching
  const tabButtons = document.querySelectorAll('.faq-tab-button');
  const categoryContents = document.querySelectorAll('.faq-category');

  tabButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const category = button.getAttribute('data-category');

      // Remove active from all tabs and content
      tabButtons.forEach((btn) => btn.classList.remove('active'));
      categoryContents.forEach((content) => content.classList.remove('active'));

      // Add active to clicked tab and corresponding content
      button.classList.add('active');
      document.querySelector(`[data-category-content="${category}"]`)?.classList.add('active');

      // Reset all FAQ items in new category
      const newFaqItems = document.querySelectorAll(`[data-category-content="${category}"] .faq-item`);
      newFaqItems.forEach((item) => item.classList.remove('open'));
    });
  });

  // FAQ accordion functionality
  const faqItems = document.querySelectorAll('.faq-item');

  faqItems.forEach((item) => {
    const button = item.querySelector('.faq-question');

    button?.addEventListener('click', () => {
      const isOpen = item.classList.contains('open');
      const currentCategory = item.closest('.faq-category');
      const siblingItems = currentCategory?.querySelectorAll('.faq-item') || [];

      // Fechar todos os outros na categoria
      siblingItems.forEach((other) => {
        other.classList.remove('open');
      });

      // Abrir o clicado se não estava aberto
      if (!isOpen) {
        item.classList.add('open');
      }
    });
  });
</script>

<style>
  .faq-section {
    padding: var(--spacing-5xl) 0;
    background-color: var(--color-bg-medium);
  }

  .section-title {
    text-align: center;
    margin-bottom: var(--spacing-md);
    font-size: clamp(1.875rem, 5vw, 2.625rem);
  }

  .section-subtitle {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--spacing-4xl);
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2vw, 1.125rem);
  }

  /* FAQ Tabs */
  .faq-tabs {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--spacing-3xl);
    border-bottom: 2px solid var(--border-light);
    padding-bottom: var(--spacing-2xl);
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .faq-tab-button {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-md) var(--spacing-lg);
    background: none;
    border: none;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    position: relative;
    transition: all 0.3s ease;
  }

  .tab-label {
    font-weight: 600;
    font-size: 1rem;
    color: inherit;
  }

  .tab-text {
    font-size: 0.7rem;
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }

  .faq-tab-button::after {
    content: '';
    position: absolute;
    bottom: -var(--spacing-2xl);
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: 30px;
    height: 2px;
    background-color: var(--color-mint);
    transition: transform 0.3s ease;
  }

  .faq-tab-button:hover {
    color: var(--color-text);
  }

  .faq-tab-button:hover .tab-text {
    opacity: 1;
  }

  .faq-tab-button.active {
    color: var(--color-mint);
  }

  .faq-tab-button.active .tab-text {
    opacity: 1;
  }

  .faq-tab-button.active::after {
    transform: translateX(-50%) scaleX(1);
  }

  /* FAQ Content */
  .faq-content {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
  }

  .faq-category {
    opacity: 0;
    visibility: hidden;
    position: absolute;
    width: 100%;
    pointer-events: none;
    transition: all 0.3s ease;
  }

  .faq-category.active {
    opacity: 1;
    visibility: visible;
    position: relative;
    pointer-events: auto;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .faq-item {
    background-color: var(--color-bg-dark);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .faq-item:hover {
    border-color: var(--color-mint);
  }

  .faq-item.open {
    border-color: var(--color-mint);
    background-color: var(--color-bg-medium);
  }

  .faq-question {
    width: 100%;
    padding: var(--spacing-lg);
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    font-size: clamp(0.95rem, 2vw, 1.05rem);
    color: var(--color-text);
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .faq-question:hover {
    color: var(--color-mint);
  }

  .faq-question svg {
    flex-shrink: 0;
    color: var(--color-mint);
    transition: transform 0.3s ease;
  }

  .faq-item.open .faq-question svg {
    transform: rotate(180deg);
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .faq-item.open .faq-answer {
    max-height: 500px;
  }

  .faq-answer p {
    padding: 0 var(--spacing-lg) var(--spacing-lg) var(--spacing-lg);
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .faq-section {
      padding: var(--spacing-4xl) 0;
    }

    .faq-question {
      padding: var(--spacing-md);
      font-size: 0.9rem;
    }

    .faq-answer p {
      padding: 0 var(--spacing-md) var(--spacing-md) var(--spacing-md);
      font-size: 0.9rem;
    }
  }
</style>
