---
const { items } = Astro.props;
---

<section id="comparativo" class="comparison-section">
  <div class="container">
    <h2 class="section-title">Por que não usar um gerador automático?</h2>
    <p class="section-subtitle">Compare: Wix, Squarespace e ferramentas similares vs. Agência Fontes</p>

    <div class="comparison-table">
      <div class="table-header">
        <div class="feature-col">Funcionalidade</div>
        <div class="option-col">
          <div class="option-header">Geradores Automáticos</div>
        </div>
        <div class="option-col">
          <div class="option-header highlighted">Agência Fontes</div>
        </div>
      </div>

      {items.map((item) => (
        <div class="table-row">
          <div class="feature-col">{item.feature}</div>
          <div class="option-col">
            <div class="check-mark">
              {item.generic ? (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              ) : (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="18" y1="6" x2="6" y2="18" />
                  <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
              )}
            </div>
          </div>
          <div class="option-col">
            <div class={`check-mark ${item.agencia ? 'active' : ''}`}>
              {item.agencia ? (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              ) : (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="18" y1="6" x2="6" y2="18" />
                  <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .comparison-section {
    padding: var(--spacing-5xl) 0;
    background-color: var(--color-bg-darkest);
  }

  .section-title {
    text-align: center;
    margin-bottom: var(--spacing-md);
    font-size: clamp(1.875rem, 5vw, 2.625rem);
  }

  .section-subtitle {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--spacing-4xl);
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2vw, 1.125rem);
  }

  .comparison-table {
    max-width: 900px;
    margin: 0 auto;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-light);
    background-color: var(--color-bg-dark);
  }

  .table-header {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0;
    background-color: var(--color-bg-medium);
    border-bottom: 2px solid var(--border-light);
    padding: var(--spacing-lg);
  }

  .feature-col {
    font-weight: 600;
    color: var(--color-text);
    font-size: 0.95rem;
  }

  .option-col {
    text-align: center;
  }

  .option-header {
    font-weight: 600;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .option-header.highlighted {
    color: var(--color-mint);
    padding: var(--spacing-sm);
    background: linear-gradient(135deg, rgba(126, 202, 202, 0.1) 0%, transparent 100%);
    border-radius: var(--radius-md);
  }

  .table-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0;
    align-items: center;
    padding: var(--spacing-lg);
    border-bottom: 1px solid var(--border-light);
    transition: background-color 0.2s ease;
  }

  .table-row:last-child {
    border-bottom: none;
  }

  .table-row:hover {
    background-color: var(--color-bg-medium);
  }

  .table-row .feature-col {
    color: var(--color-text);
    font-size: 0.95rem;
  }

  .check-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
    width: 24px;
    height: 24px;
    margin: 0 auto;
    transition: color 0.2s ease;
  }

  .check-mark.active {
    color: var(--color-mint);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .comparison-section {
      padding: var(--spacing-4xl) 0;
    }

    .table-header {
      grid-template-columns: 1fr;
      gap: var(--spacing-sm);
      padding: var(--spacing-md);
    }

    .feature-col {
      font-size: 0.85rem;
    }

    .option-col {
      padding: var(--spacing-md);
      background-color: var(--color-bg-medium);
      border-radius: var(--radius-md);
      margin-top: var(--spacing-sm);
    }

    .option-header {
      font-size: 0.85rem;
      margin-bottom: var(--spacing-sm);
    }

    .option-header.highlighted {
      padding: var(--spacing-sm);
      margin: 0;
      background: linear-gradient(135deg, rgba(126, 202, 202, 0.2) 0%, transparent 100%);
    }

    .table-row {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
      padding: var(--spacing-md);
      align-items: flex-start;
    }

    .table-row .feature-col {
      font-size: 0.85rem;
      margin-bottom: var(--spacing-md);
      font-weight: 600;
    }

    .check-mark {
      width: 20px;
      height: 20px;
    }
  }
</style>
