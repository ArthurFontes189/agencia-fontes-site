<div class="browser-mockup">
  <div class="browser-header">
    <div class="browser-dots">
      <div></div>
      <div></div>
      <div></div>
    </div>
    <div class="browser-url">agencia-fontes.com.br</div>
  </div>
  <div class="browser-content">
    <!-- Carousel de Slides -->
    <div class="carousel">
      <!-- Slide 1: Desktop Portfolio Grid -->
      <div class="carousel-slide active" data-slide="0">
        <div class="slide-label">📱 Desktop - Portfolio (3 Colunas)</div>
        <div class="portfolio-grid desktop">
          <div class="portfolio-item">
            <div class="portfolio-image"></div>
            <div class="portfolio-text">Projeto 1</div>
          </div>
          <div class="portfolio-item">
            <div class="portfolio-image"></div>
            <div class="portfolio-text">Projeto 2</div>
          </div>
          <div class="portfolio-item">
            <div class="portfolio-image"></div>
            <div class="portfolio-text">Projeto 3</div>
          </div>
        </div>
      </div>

      <!-- Slide 2: Tablet Portfolio Grid -->
      <div class="carousel-slide" data-slide="1">
        <div class="slide-label">📱 Tablet - Portfolio (2 Colunas)</div>
        <div class="portfolio-grid tablet">
          <div class="portfolio-item">
            <div class="portfolio-image"></div>
            <div class="portfolio-text">Projeto 1</div>
          </div>
          <div class="portfolio-item">
            <div class="portfolio-image"></div>
            <div class="portfolio-text">Projeto 2</div>
          </div>
          <div class="portfolio-item">
            <div class="portfolio-image"></div>
            <div class="portfolio-text">Projeto 3</div>
          </div>
        </div>
      </div>

      <!-- Slide 3: Mobile Portfolio Stack -->
      <div class="carousel-slide" data-slide="2">
        <div class="slide-label">📱 Mobile - Portfolio (1 Coluna)</div>
        <div class="portfolio-grid mobile">
          <div class="portfolio-item">
            <div class="portfolio-image"></div>
            <div class="portfolio-text">Projeto 1</div>
          </div>
          <div class="portfolio-item">
            <div class="portfolio-image"></div>
            <div class="portfolio-text">Projeto 2</div>
          </div>
          <div class="portfolio-item">
            <div class="portfolio-image"></div>
            <div class="portfolio-text">Projeto 3</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Carousel Controls -->
    <div class="carousel-controls">
      <button class="carousel-btn prev" aria-label="Slide anterior">◄</button>
      <div class="carousel-indicators">
        <button class="indicator active" data-slide="0" aria-label="Slide 1"></button>
        <button class="indicator" data-slide="1" aria-label="Slide 2"></button>
        <button class="indicator" data-slide="2" aria-label="Slide 3"></button>
      </div>
      <button class="carousel-btn next" aria-label="Próximo slide">►</button>
    </div>
  </div>
</div>

<style>
  .browser-mockup {
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg-medium);
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  .browser-header {
    background-color: var(--color-bg-dark);
    padding: var(--spacing-md);
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    border-bottom: 1px solid var(--border-light);
  }

  .browser-dots {
    display: flex;
    gap: var(--spacing-sm);
  }

  .browser-dots div {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--border-medium);
  }

  .browser-dots div:nth-child(1) {
    background-color: #EF5350;
  }

  .browser-dots div:nth-child(2) {
    background-color: #FFBA2E;
  }

  .browser-dots div:nth-child(3) {
    background-color: #4CAF50;
  }

  .browser-url {
    color: var(--color-text-tertiary);
    font-size: 0.875rem;
    font-family: var(--font-mono);
    flex: 1;
    text-align: center;
  }

  .browser-content {
    height: 400px;
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, var(--color-bg-dark) 0%, var(--color-bg-medium) 100%);
  }

  /* Carousel */
  .carousel {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .carousel-slide {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
    display: flex;
    flex-direction: column;
    padding: var(--spacing-lg);
    gap: var(--spacing-md);
    pointer-events: none;
  }

  .carousel-slide.active {
    opacity: 1;
    pointer-events: auto;
  }

  .slide-label {
    font-size: 0.85rem;
    color: var(--color-text-tertiary);
    text-align: center;
    font-weight: 600;
  }

  /* Portfolio Grid */
  .portfolio-grid {
    display: grid;
    gap: var(--spacing-md);
    flex: 1;
    place-items: center;
  }

  .portfolio-grid.desktop {
    grid-template-columns: repeat(3, 1fr);
  }

  .portfolio-grid.tablet {
    grid-template-columns: repeat(2, 1fr);
  }

  .portfolio-grid.mobile {
    grid-template-columns: 1fr;
  }

  .portfolio-item {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    align-items: center;
    width: 100%;
  }

  .portfolio-image {
    width: 100%;
    aspect-ratio: 1;
    background: linear-gradient(135deg, rgba(24, 93, 241, 0.2) 0%, rgba(16, 71, 201, 0.1) 100%);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    position: relative;
    overflow: hidden;
  }

  .portfolio-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(45deg, transparent 30%, rgba(24, 93, 241, 0.1) 50%, transparent 70%),
      linear-gradient(-45deg, transparent 30%, rgba(24, 93, 241, 0.1) 50%, transparent 70%);
    animation: shimmer 2s infinite;
  }

  @keyframes shimmer {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  .portfolio-text {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  /* Carousel Controls */
  .carousel-controls {
    position: absolute;
    bottom: var(--spacing-md);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    z-index: 10;
  }

  .carousel-btn {
    background-color: rgba(24, 93, 241, 0.6);
    color: white;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    transition: all 0.3s ease;
    font-weight: 600;
  }

  .carousel-btn:hover {
    background-color: var(--color-mint);
    color: var(--color-bg-darkest);
    transform: scale(1.1);
  }

  .carousel-indicators {
    display: flex;
    gap: var(--spacing-sm);
  }

  .indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background-color: rgba(255, 255, 255, 0.3);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .indicator.active {
    background-color: var(--color-mint);
    width: 24px;
    border-radius: var(--radius-full);
  }

  .indicator:hover {
    background-color: rgba(24, 93, 241, 0.8);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .browser-content {
      height: 300px;
    }

    .carousel-slide {
      padding: var(--spacing-md);
      gap: var(--spacing-sm);
    }

    .slide-label {
      font-size: 0.75rem;
    }

    .portfolio-grid.desktop {
      grid-template-columns: repeat(2, 1fr);
    }

    .carousel-btn {
      width: 28px;
      height: 28px;
      font-size: 0.75rem;
    }
  }
</style>

<script>
  const carousel = document.querySelector('.carousel');
  const slides = document.querySelectorAll('.carousel-slide');
  const indicators = document.querySelectorAll('.indicator');
  const prevBtn = document.querySelector('.carousel-btn.prev');
  const nextBtn = document.querySelector('.carousel-btn.next');

  let currentSlide = 0;
  let autoplayInterval: NodeJS.Timeout;

  function showSlide(n: number) {
    slides.forEach((slide) => slide.classList.remove('active'));
    indicators.forEach((indicator) => indicator.classList.remove('active'));

    slides[n].classList.add('active');
    indicators[n].classList.add('active');
    currentSlide = n;
  }

  function nextSlide() {
    showSlide((currentSlide + 1) % slides.length);
    resetAutoplay();
  }

  function prevSlide() {
    showSlide((currentSlide - 1 + slides.length) % slides.length);
    resetAutoplay();
  }

  function resetAutoplay() {
    clearInterval(autoplayInterval);
    startAutoplay();
  }

  function startAutoplay() {
    autoplayInterval = setInterval(() => {
      nextSlide();
    }, 5000);
  }

  prevBtn?.addEventListener('click', prevSlide);
  nextBtn?.addEventListener('click', nextSlide);

  indicators.forEach((indicator) => {
    indicator.addEventListener('click', (e) => {
      const slideNum = parseInt((e.target as HTMLElement).getAttribute('data-slide') || '0');
      showSlide(slideNum);
      resetAutoplay();
    });
  });

  startAutoplay();
</script>
