---
const { title, subtitle, items } = Astro.props;

const getIcon = (iconName: string) => {
  const icons: Record<string, string> = {
    globe: `<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"/>
      <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
    </svg>`,
    'map-pin': `<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
      <circle cx="12" cy="10" r="3"/>
    </svg>`,
    server: `<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2" y="2" width="20" height="8" rx="2" ry="2"/>
      <rect x="2" y="14" width="20" height="8" rx="2" ry="2"/>
      <line x1="6" y1="6" x2="6" y2="6.01"/>
      <line x1="6" y1="18" x2="6" y2="18.01"/>
    </svg>`,
    camera: `<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
      <circle cx="12" cy="13" r="4"/>
    </svg>`,
    'edit-3': `<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M7 17L17 7M17 7h-5M17 7v5"/>
    </svg>`,
    'trending-up': `<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
      <polyline points="17 6 23 6 23 12"/>
    </svg>`,
    calendar: `<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
      <line x1="16" y1="2" x2="16" y2="6"/>
      <line x1="8" y1="2" x2="8" y2="6"/>
      <line x1="3" y1="10" x2="21" y2="10"/>
    </svg>`,
    'help-circle': `<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"/>
      <path d="M12 16v-4M12 8h.01"/>
    </svg>`,
  };
  return icons[iconName] || icons.globe;
};
---

<section class="services-section">
  <div class="container">
    <h2 class="section-title">{title}</h2>
    <p class="section-subtitle">{subtitle}</p>

    <div class="bento-grid">
      {items.map((item) => (
        <div class="bento-card" data-span={item.span}>
          <div class="card-content">
            <div class="card-icon">
              <div set:html={getIcon(item.icon)} />
            </div>

            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    padding: var(--spacing-5xl) 0;
    background-color: var(--color-bg-darkest);
  }

  .section-title {
    text-align: center;
    margin-bottom: var(--spacing-md);
    font-size: clamp(1.875rem, 5vw, 2.625rem);
  }

  .section-subtitle {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--spacing-4xl);
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2vw, 1.125rem);
  }

  .bento-grid {
    display: grid;
    gap: var(--spacing-2xl);
    grid-auto-flow: dense;
  }

  .bento-card {
    background-color: var(--color-bg-dark);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: var(--spacing-2xl);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    animation: slideUp 0.6s ease-out;
  }

  .bento-card:nth-child(1) {
    animation-delay: 0.1s;
  }

  .bento-card:nth-child(2) {
    animation-delay: 0.15s;
  }

  .bento-card:nth-child(3) {
    animation-delay: 0.2s;
  }

  .bento-card:nth-child(4) {
    animation-delay: 0.25s;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .bento-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(126, 202, 202, 0.1) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .bento-card:hover {
    border-color: var(--color-mint);
    background-color: var(--color-bg-medium);
    transform: translateY(-8px);
    box-shadow: 0 0 40px rgba(126, 202, 202, 0.2);
  }

  .bento-card:hover::before {
    opacity: 1;
  }

  /* Bento layout: primeiro card maior em desktop */
  .bento-card[data-span="2"] {
    grid-column: span 2;
    grid-row: span 2;
  }

  .card-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .card-icon {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, rgba(126, 202, 202, 0.15) 0%, rgba(61, 136, 136, 0.05) 100%);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-medium);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-mint);
    transition: all 0.3s ease;
  }

  .bento-card:hover .card-icon {
    background: linear-gradient(135deg, rgba(126, 202, 202, 0.25) 0%, rgba(61, 136, 136, 0.15) 100%);
    border-color: var(--color-mint);
    transform: scale(1.1);
  }

  .card-content h3 {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    color: var(--color-text);
    margin: 0;
  }

  .card-content p {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Desktop: 4 columns with bento variation */
  @media (min-width: 1024px) {
    .bento-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .bento-card[data-span="2"] {
      grid-column: span 2;
      grid-row: span 2;
    }
  }

  /* Tablet: 2 columns */
  @media (min-width: 769px) and (max-width: 1023px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .bento-card[data-span="2"] {
      grid-column: span 2;
      grid-row: span 1;
    }
  }

  /* Mobile: 1 column */
  @media (max-width: 768px) {
    .services-section {
      padding: var(--spacing-4xl) 0;
    }

    .bento-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
    }

    .bento-card {
      padding: var(--spacing-xl);
    }

    .bento-card[data-span="2"] {
      grid-column: span 1;
      grid-row: span 1;
    }
  }
</style>
