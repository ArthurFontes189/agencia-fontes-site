---
const whatsappNumber = '61999165536';
const whatsappMessage = 'Olá! Gostaria de entrar em contato com a Agência Fontes.';
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<section id="contato" class="contact-section">
  <div class="container">
    <h2 class="section-title">Vamos conversar?</h2>
    <p class="section-subtitle">Manda sua mensagem direto. A gente responde rápido.</p>

    <div class="contact-grid">
      <form class="contact-form" id="contact-form">
        <div class="form-group">
          <label for="name">Seu nome</label>
          <input type="text" id="name" name="name" placeholder="João Silva" required />
        </div>

        <div class="form-group">
          <label for="email">Seu email</label>
          <input type="email" id="email" name="email" placeholder="joao@example.com" required />
        </div>

        <div class="form-group">
          <label for="phone">Seu WhatsApp</label>
          <input type="tel" id="phone" name="phone" placeholder="(61) 99999-9999" />
        </div>

        <div class="form-group">
          <label for="subject">Assunto</label>
          <select id="subject" name="subject" required>
            <option value="">Escolha um assunto</option>
            <option value="website">Website</option>
            <option value="marketing">Marketing Digital</option>
            <option value="sistema">Sistema/Dashboard</option>
            <option value="outro">Outro</option>
          </select>
        </div>

        <div class="form-group full">
          <label for="message">Sua mensagem</label>
          <textarea id="message" name="message" placeholder="Conte-nos o que você precisa..." rows="5" required></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Enviar via WhatsApp</button>
      </form>

      <div class="contact-info">
        <h3>Entre em contato</h3>

        <div class="contact-item">
          <div class="contact-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
          </div>
          <div>
            <p class="contact-label">WhatsApp</p>
            <a href={whatsappLink} target="_blank" rel="noopener noreferrer">+55 61 99991-6553</a>
          </div>
        </div>

        <div class="contact-item">
          <div class="contact-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
          </div>
          <div>
            <p class="contact-label">Email</p>
            <a href="mailto:agenciafontes@gmail.com">agenciafontes@gmail.com</a>
          </div>
        </div>

        <div class="contact-item">
          <div class="contact-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
          </div>
          <div>
            <p class="contact-label">Localização</p>
            <p>Brasília, DF</p>
          </div>
        </div>

        <div class="social-links">
          <a href="https://www.instagram.com/agencia-fontes" target="_blank" rel="noopener noreferrer" title="Instagram" class="social-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" fill="none" stroke="currentColor" stroke-width="2" />
              <path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10z" fill="none" stroke="currentColor" stroke-width="2" />
              <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" />
            </svg>
            <span>@agencia.fontes</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const name = (document.getElementById('name') as HTMLInputElement)?.value || '';
      const email = (document.getElementById('email') as HTMLInputElement)?.value || '';
      const phone = (document.getElementById('phone') as HTMLInputElement)?.value || '';
      const subject = (document.getElementById('subject') as HTMLSelectElement)?.value || '';
      const message = (document.getElementById('message') as HTMLTextAreaElement)?.value || '';

      const whatsappNumber = '61999165536';
      const whatsappMessage = `*Novo contato pelo site*\n\nNome: ${name}\nEmail: ${email}\nTelefone: ${phone}\nAssunto: ${subject}\nMensagem: ${message}`;
      const whatsappLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;

      window.open(whatsappLink, '_blank');
    });
  }
</script>

<style>
  .contact-section {
    padding: var(--spacing-5xl) 0;
    background-color: var(--color-bg-darkest);
  }

  .section-title {
    text-align: center;
    margin-bottom: var(--spacing-md);
    font-size: clamp(1.875rem, 5vw, 2.625rem);
  }

  .section-subtitle {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--spacing-4xl);
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2vw, 1.125rem);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-3xl);
    max-width: 1000px;
    margin: 0 auto;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    background-color: var(--color-bg-dark);
    padding: var(--spacing-2xl);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-light);
    animation: slideUp 0.6s ease-out 0.2s both;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .form-group.full {
    grid-column: 1 / -1;
  }

  .form-group label {
    color: var(--color-text);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: var(--spacing-md);
    background-color: var(--color-bg-medium);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-family: inherit;
    font-size: 0.95rem;
    transition: border-color 0.2s ease;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-mint);
    box-shadow: 0 0 0 3px rgba(126, 202, 202, 0.1);
  }

  .form-group textarea {
    resize: vertical;
    font-family: inherit;
  }

  .btn {
    padding: var(--spacing-md) var(--spacing-lg);
    background-color: var(--color-mint);
    color: var(--color-bg-darkest);
    border: none;
    border-radius: var(--radius-md);
    font-weight: 600;
    cursor: pointer;
    font-size: 0.95rem;
    transition: all 0.3s ease;
  }

  .btn:hover {
    background-color: var(--color-mint-light);
    transform: translateY(-2px);
    box-shadow: 0 0 20px rgba(126, 202, 202, 0.3);
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2xl);
    animation: slideUp 0.6s ease-out 0.3s both;
  }

  .contact-info h3 {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    color: var(--color-text);
    margin: 0;
  }

  .contact-item {
    display: flex;
    gap: var(--spacing-lg);
  }

  .contact-icon {
    flex-shrink: 0;
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, rgba(126, 202, 202, 0.15) 0%, rgba(61, 136, 136, 0.05) 100%);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-mint);
    border: 1px solid var(--border-medium);
  }

  .contact-label {
    color: var(--color-text);
    font-weight: 600;
    font-size: 0.9rem;
    margin: 0 0 var(--spacing-xs) 0;
  }

  .contact-item p {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    margin: 0;
  }

  .contact-item a {
    color: var(--color-mint);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .contact-item a:hover {
    color: var(--color-mint-light);
  }

  .social-links {
    display: flex;
    gap: var(--spacing-md);
    margin-top: var(--spacing-lg);
  }

  .social-links a {
    background-color: var(--color-bg-dark);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing-md);
    color: var(--color-mint);
    transition: all 0.2s ease;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .social-links a svg {
    flex-shrink: 0;
  }

  .social-links a:hover {
    border-color: var(--color-mint);
    background-color: var(--color-bg-medium);
    transform: translateY(-2px);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .contact-section {
      padding: var(--spacing-4xl) 0;
    }

    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-2xl);
    }

    .contact-form {
      padding: var(--spacing-xl);
    }
  }
</style>
