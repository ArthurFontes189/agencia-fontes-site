---
const { items } = Astro.props;
---

<section id="como-funciona" class="how-it-works-section">
  <div class="container">
    <h2 class="section-title">Como funciona</h2>
    <p class="section-subtitle">4 passos simples do seu site à realidade</p>

    <div class="timeline-container">
      {items.map((item, index) => (
        <div class="timeline-step" data-step={item.step}>
          {/* Timeline dot/connector */}
          <div class="timeline-dot">
            <div class="dot-inner">{item.step}</div>
          </div>

          {/* Timeline connector line (except last item) */}
          {index < items.length - 1 && <div class="timeline-line"></div>}

          {/* Step content */}
          <div class="step-content">
            <h3 class="step-title">{item.title}</h3>
            <p class="step-description">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .how-it-works-section {
    padding: var(--spacing-5xl) 0;
    background-color: var(--color-bg-medium);
    position: relative;
    overflow: hidden;
  }

  .section-title {
    text-align: center;
    margin-bottom: var(--spacing-md);
    font-size: clamp(1.875rem, 5vw, 2.625rem);
  }

  .section-subtitle {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--spacing-4xl);
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2vw, 1.125rem);
  }

  /* Timeline Layout */
  .timeline-container {
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
    max-width: 600px;
    margin: 0 auto;
  }

  .timeline-step {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: var(--spacing-2xl);
    align-items: flex-start;
    position: relative;
    padding: var(--spacing-2xl) 0;
    opacity: 0;
    animation: fadeInStep 0.6s ease-out forwards;
  }

  .timeline-step[data-step="1"] {
    animation-delay: 0.1s;
  }

  .timeline-step[data-step="2"] {
    animation-delay: 0.25s;
  }

  .timeline-step[data-step="3"] {
    animation-delay: 0.4s;
  }

  .timeline-step[data-step="4"] {
    animation-delay: 0.55s;
  }

  @keyframes fadeInStep {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Timeline Dot */
  .timeline-dot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 60px;
    z-index: 2;
  }

  .dot-inner {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-mint-dark) 0%, var(--color-mint-darkest) 100%);
    border: 3px solid var(--color-bg-darkest);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--color-mint);
    box-shadow: 0 0 20px rgba(126, 202, 202, 0.3);
    transition: all 0.3s ease;
  }

  .timeline-step:hover .dot-inner {
    box-shadow: 0 0 30px rgba(126, 202, 202, 0.5);
    transform: scale(1.1);
  }

  /* Timeline Connector Line */
  .timeline-line {
    position: absolute;
    left: 29px;
    top: 60px;
    width: 2px;
    height: calc(100% + 20px);
    background: linear-gradient(to bottom, var(--color-mint), transparent);
    z-index: 1;
  }

  .timeline-step:last-child .timeline-line {
    display: none;
  }

  /* Step Content */
  .step-content {
    padding: var(--spacing-lg);
    background-color: var(--color-bg-dark);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    transition: all 0.3s ease;
  }

  .timeline-step:hover .step-content {
    border-color: var(--color-mint);
    background-color: var(--color-bg-medium);
    box-shadow: 0 0 20px rgba(126, 202, 202, 0.15);
  }

  .step-title {
    margin: 0 0 var(--spacing-md) 0;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    color: var(--color-text);
    font-weight: 600;
  }

  .step-description {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Responsive - Mobile timeline goes horizontal */
  @media (max-width: 768px) {
    .how-it-works-section {
      padding: var(--spacing-4xl) 0;
    }

    .timeline-container {
      max-width: 100%;
    }

    .timeline-step {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
      padding: var(--spacing-xl) 0;
      padding-left: var(--spacing-2xl);
    }

    .timeline-dot {
      position: absolute;
      left: -30px;
      height: auto;
    }

    .timeline-line {
      left: -30px;
      top: 50px;
      height: calc(100% - 40px);
    }

    .step-content {
      padding: var(--spacing-lg);
    }

    .step-title {
      font-size: 1.125rem;
    }

    .step-description {
      font-size: 0.9rem;
    }
  }

  /* Tablet - adjust spacing */
  @media (min-width: 769px) and (max-width: 1024px) {
    .timeline-step {
      padding: var(--spacing-2xl) 0;
    }
  }
</style>
